<% layout("layouts/boilerplate") %>

    <div class="row mt-3">
        <h2 class="col-6 offset-3">SignUp on Wanderlust!</h2>
        <div class="col-6 offset-3">
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">username</label>
                    <input id="username" type="text" class="form-control" id="title" name="username" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">email</label>
                    <input id="email" type="email" class="form-control" id="email" name="email" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">password</label>
                    <input id="password" type="password" class="form-control" id="password" name="password" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>  
                <button class="btn btn-success">SignUp</button>              
            </form>
        </div>
    </div>