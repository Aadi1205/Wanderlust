<% layout("layouts/boilerplate") %>

    <div class="row mt-3">
        <h2 class="col-6 offset-3">Login on Wanderlust!</h2>
        <div class="col-6 offset-3">
            <form action="/login" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">username</label>
                    <input id="username" type="text" class="form-control" id="title" name="username" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">password</label>
                    <input id="password" type="password" class="form-control" id="password" name="password" required>
                </div>
                <button class="btn btn-success">Login</button>
            </form>
        </div>
    </div>