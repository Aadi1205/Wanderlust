<% layout("layouts/boilerplate") %>

  <div class="row">
    <div class="col-12 col-md-8 offset-md-2 px-4">
      <div class="container mt-4">
        <br>
        <h3 class="mb-4">Edit Profile</h3>

        <form action="/users/<%= profileUser._id %>?_method=PUT" method="POST" class="needs-validation" novalidate
          enctype="multipart/form-data">

          <div class="mb-3">
            <b>Profile Photo:</b><br>
            <% if (profileUser.avatar && profileUser.avatar.url) { %>
              <img src="<%= profileUser.avatar.url %>" class="profile-avatar mb-2" alt="Current avatar">
            <% } else { %>
              <div class="profile-avatar profile-avatar-initials mb-2">
                <%= profileUser.initials %>
              </div>
              <% } %>
          </div>

          <div class="mb-3">
            <label for="avatar" class="form-label">Upload new photo</label>
            <input type="file" class="form-control" name="avatar" id="avatar">
          </div>

          <!-- Full Name -->
          <div class="mb-3">
            <label for="fullName" class="form-label">Full name</label>
            <input type="text" class="form-control" id="fullName" name="user[fullName]"
              value="<%= profileUser.fullName || '' %>" maxlength="60">
          </div>

          <!-- Email -->
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="user[email]" value="<%= profileUser.email %>"
              required>
            <div class="invalid-feedback">
              Please enter a valid email
            </div>
          </div>

          <!-- Location -->
          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" class="form-control" id="location" name="user[location]"
              value="<%= profileUser.location || '' %>" maxlength="100">
          </div>

          <!-- Bio -->
          <div class="mb-3">
            <label for="bio" class="form-label">Bio</label>
            <textarea class="form-control" id="bio" name="user[bio]" rows="4" maxlength="500"><%= profileUser.bio || '' %></textarea>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn btn-dark add-btn">
            Save changes
          </button>

          <br><br>

        </form>

        <% if (profileUser.avatar && profileUser.avatar.url) { %>
          <form action="/users/<%= profileUser._id %>/avatar?_method=DELETE" method="POST" class="mb-4">
            <button type="submit" class="btn btn-outline-danger btn-sm">Remove photo</button>
          </form>
          <% } %>
      </div>
    </div>
  </div>
