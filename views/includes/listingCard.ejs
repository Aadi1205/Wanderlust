<% const isWishlisted = typeof wishlistedIds !== 'undefined' && wishlistedIds.has(listing._id.toString()); %>
<a href="/listings/<%= listing._id %>" class="listing-link">
  <div class="card col listing-card">
    <img src="<%= listing.image?.url%>" class="card-img-top" style="height: 20rem" alt="Listing image" />

    <div class="card-img-overlay"></div>

    <% if (typeof currUser !== 'undefined' && currUser) { %>
      <button type="button" class="wishlist-heart-btn <%= isWishlisted ? 'active' : '' %>"
        data-listing-id="<%= listing._id %>" aria-label="Save to wishlist">
        <i class="<%= isWishlisted ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
      </button>
    <% } %>

    <div class="card-body">
      <p class="card-text">
        <b>
          <%=listing.title%>
        </b>
        <% if (listing.reviewCount> 0) { %>
          <span class="listing-rating"><i class="fa-solid fa-star"></i>
            <%= listing.avgRating.toFixed(1) %>
          </span>
          <% } %>
            <br />
            <span class="price" data-base-price="<%= listing.price %>">
              &#8377;<%= listing.price.toLocaleString("en-IN") %>
            </span>
            <span class="price-label"> / night</span>
            <span class="tax-label" style="display:none;"> (incl. tax)</span>
      </p>
    </div>
  </div>
</a>
