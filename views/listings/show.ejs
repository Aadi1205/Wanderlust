<% layout('layouts/boilerplate') -%>

  <body>

    <!-- Title -->
    <div class="row">
      <div class="col-12 col-md-6 offset-md-3 mt-3 px-3">
        <h3>
          <%= listing.title %>
        </h3>
      </div>
    </div>

    <!-- Listing Card -->
    <div class="row">
      <div class="card col-12 col-md-6 offset-md-3 show-card border-0 px-3">
        <img
          src="<%= listing.image.url || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>"
          class="card-img-top show-img" alt="Listing image" />

        <div class="card-body">
          <p class="card-text">
            <b>Owned By:</b>
            <i>
              <%= listing.owner.username %>
            </i>
          </p>

          <p class="card-text">
            <b>Description:</b>
            <%= listing.description %>
          </p>

          <p class="card-text">
            <b>Price:</b> ₹<%= listing.price.toLocaleString("en-IN") %>
          </p>

          <p class="card-text">
            <b>Location:</b>
            <%= listing.location %>
          </p>

          <p class="card-text">
            <b>Country:</b>
            <%= listing.country %>
          </p>

          <p class="card-text">
            <b>Category:</b>
            <%= listing.category %>
          </p>
        </div>
      </div>
    </div>

    <!-- Buttons -->
    <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
      <div class="row mt-3">
        <div class="col-12 col-md-6 offset-md-3 d-flex gap-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>

          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="delete-listing-form">
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>

        </div>
      </div>
      <br>
      <% } %>

        <!-- Review Form -->
        <% if (currUser) { %>
          <div class="row">
            <div class="col-12 col-md-6 offset-md-3">
              <hr>
              <h4 class="mb-3">Leave a review</h4>

              <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

                <!-- Star Rating -->
                <div>
                  <label for="rating" class="form-label"><b>Rating: </b></label>
                  <br>
                  <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />

                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1">1 star</label>

                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2">2 stars</label>

                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3">3 stars</label>

                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4">4 stars</label>

                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5">5 stars</label>
                  </fieldset>
                </div>

                <!-- Comment -->
                <div class="mb-3">
                  <label class="form-label" for="comment"><b>Comment:</b></label>
                  <textarea name="review[comment]" id="comment" placeholder="Write comment" rows="5"
                    class="form-control" required></textarea>

                  <div class="invalid-feedback">
                    Please add some comments for review.
                  </div>
                </div>

                <!-- Submit -->
                <button class="btn btn-outline-dark mb-3">Submit</button>

              </form>
            </div>
          </div>
          <% } %>

            <!-- All Reviews -->
            <% if (listing.reviews.length> 0) { %>
              <div class="row">
                <div class="col-12 col-md-6 offset-md-3 mb-5">
                  <hr>
                  <p><b>All Reviews</b></p>

                  <div class="row">
                    <% for (let review of listing.reviews) { %>

                      <div class="col-12 col-md-6 mb-3">
                        <div class="review-card">

                          <div class="review-header">
                            <span class="review-user">@<%= review.author.username %></span>
                            <span class="starability-result" data-rating="<%= review.rating %>"></span>
                          </div>

                          <p class="review-comment">
                            <%= review.comment %>
                          </p>

                          <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                              method="POST" class="delete-review-form">
                              <button type="submit" class="btn btn-sm btn-outline-danger review-delete-btn">
                                Delete
                              </button>
                            </form>
                            <% } %>
                        </div>
                      </div>

                      <% } %>
                  </div>
                </div>
              </div>
              <% } %>


                <!-- Map -->
                <div class="row">
                  <div class="col-12 col-md-6 offset-md-3">
                    <hr>
                    <div id="map" data-coords='<%= JSON.stringify(listing.geometry?.coordinates || [0,0]) %>'
                      data-title="<%= listing.title %>" style="height: 350px; border-radius: 10px;"></div>
                  </div>
                </div>



                <script src="/js/map.js"></script>
                <script src="/js/confirmDelete.js"></script>

  </body>