<% layout('layouts/boilerplate') -%>
  <% const activeCategory=category || "" ; %>

    <body>
      <div id="filters">

        <a href="/listings?category=Trending" class="filter <%= activeCategory === 'Trending' ? 'active' : '' %>">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p>
        </a>

        <a href="/listings?category=Room" class="filter <%= activeCategory === 'Room' ? 'active' : '' %>">
          <div><i class="fa-solid fa-bed"></i></div>
          <p>Room</p>
        </a>

        <a href="/listings?category=Iconic" class="filter <%= activeCategory === 'Iconic' ? 'active' : '' %>">
          <div><i class="fa-solid fa-mountain-city"></i></div>
          <p>Iconic cities</p>
        </a>

        <a href="/listings?category=Mountain" class="filter <%= activeCategory === 'Mountain' ? 'active' : '' %>">
          <div><i class="fa-solid fa-mountain"></i></div>
          <p>Mountain</p>
        </a>

        <a href="/listings?category=Castles" class="filter <%= activeCategory === 'Castles' ? 'active' : '' %>">
          <div><i class="fa-brands fa-fort-awesome"></i></div>
          <p>Castles</p>
        </a>

        <a href="/listings?category=Pools" class="filter <%= activeCategory === 'Pools' ? 'active' : '' %>">
          <div><i class="fa-solid fa-person-swimming"></i></div>
          <p>Amazing Pools</p>
        </a>

        <a href="/listings?category=Camping" class="filter <%= activeCategory === 'Camping' ? 'active' : '' %>">
          <div><i class="fa-solid fa-campground"></i></div>
          <p>Camping</p>
        </a>

        <a href="/listings?category=Farms" class="filter <%= activeCategory === 'Farms' ? 'active' : '' %>">
          <div><i class="fa-solid fa-cow"></i></div>
          <p>Farms</p>
        </a>

        <a href="/listings?category=Arctic" class="filter <%= activeCategory === 'Arctic' ? 'active' : '' %>">
          <div><i class="fa-regular fa-snowflake"></i></div>
          <p>Arctic</p>
        </a>

        <a href="/listings?category=Domes" class="filter <%= activeCategory === 'Domes' ? 'active' : '' %>">
          <div><i class="fa-solid fa-igloo"></i></div>
          <p>Domes</p>
        </a>

        <a href="/listings?category=Boat" class="filter <%= activeCategory === 'Boat' ? 'active' : '' %>">
          <div><i class="fa-solid fa-sailboat"></i></div>
          <p>Boat</p>
        </a>



        <div class="tax-toggle ms-auto">
          <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked">
            <label class="form-check-label" for="switchCheckChecked">Display total after taxes</label>
          </div>
        </div>
      </div>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% if(allListings.length===0) { %>
          <div class="col-12 d-flex justify-content-center mt-5">
            <div class="text-center p-4 border rounded shadow-sm" style="max-width: 400px;">
              <i class="fa-regular fa-face-frown fa-2x mb-3 text-danger"></i>
              <h5>No listings found</h5>
              <p class="text-muted mb-2">Try searching with a different name or country.</p>
              <a href="/listings" class="btn btn-outline-danger btn-sm">Back to explore</a>
            </div>
          </div>
          <% } %>

            <% for(let listing of allListings) { %>
              <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="card col listing-card">
                  <img src="<%= listing.image?.url%>" class="card-img-top" style="height: 20rem" alt="Listing image" />

                  <div class="card-img-overlay"></div>
                  <div class="card-body">
                    <p class="card-text">
                      <b>
                        <%=listing.title%><br />
                      </b>
                      <span class="price" data-base-price="<%= listing.price %>">
                        &#8377;<%= listing.price.toLocaleString("en-IN") %>
                      </span>
                      <span class="price-label"> / night</span>
                      <span class="tax-label" style="display:none;"> (incl. tax)</span>
                    </p>
                  </div>
                </div>
              </a>
              <% } %>
      </div>
    </body>
    <script src="js/showTax.js"></script>
   
