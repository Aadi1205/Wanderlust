<% layout('layouts/boilerplate') -%>

  <body>
    <div class="listings-page-layout">

      <button type="button" id="filterToggleBtn" class="filter-toggle-btn d-md-none">
        <i class="fa-solid fa-sliders"></i> Filters
      </button>
      <div id="filterOverlay" class="filter-overlay"></div>

      <aside id="filterSidebar" class="filter-sidebar">
        <div class="filter-sidebar-header">
          <h5 class="mb-0">Filters</h5>
          <button type="button" id="filterCloseBtn" class="filter-close-btn d-md-none" aria-label="Close filters">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <form id="filterForm">
          <div class="filter-group">
            <label class="filter-label" for="filterCategory">Category</label>
            <select class="form-select form-select-sm" id="filterCategory" name="category">
              <option value="">All categories</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c %>" <%= category===c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="filterOwner">Host</label>
            <select class="form-select form-select-sm" id="filterOwner" name="owner">
              <option value="">All hosts</option>
              <% owners.forEach(function(o) { %>
                <option value="<%= o._id %>" <%= owner===o._id.toString() ? 'selected' : '' %>><%= o.username %>
                </option>
                <% }) %>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="filterLocation">Location</label>
            <select class="form-select form-select-sm" id="filterLocation" name="location">
              <option value="">All locations</option>
              <% locations.forEach(function(l) { %>
                <option value="<%= l %>" <%= location===l ? 'selected' : '' %>><%= l %></option>
                <% }) %>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-label">Price per night (&#8377;)</label>
            <div class="d-flex gap-2">
              <input type="number" min="0" class="form-control form-control-sm" name="minPrice" placeholder="Min"
                value="<%= minPrice || '' %>">
              <input type="number" min="0" class="form-control form-control-sm" name="maxPrice" placeholder="Max"
                value="<%= maxPrice || '' %>">
            </div>
          </div>

          <div class="filter-group">
            <label class="filter-label" for="filterSort">Sort by price</label>
            <select class="form-select form-select-sm" id="filterSort" name="sort">
              <option value="">Default</option>
              <option value="price_asc" <%= sort==='price_asc' ? 'selected' : '' %>>Low to High</option>
              <option value="price_desc" <%= sort==='price_desc' ? 'selected' : '' %>>High to Low</option>
            </select>
          </div>

          <button type="button" id="clearFiltersBtn" class="btn btn-outline-secondary btn-sm w-100 mt-1">
            Clear all filters
          </button>
        </form>
      </aside>

      <div class="listings-main">
        <div class="listings-toolbar d-flex justify-content-between align-items-center flex-wrap mb-2">
          <p class="listings-count mb-0" id="listingsCount">
            <%= allListings.length %> listing<%= allListings.length===1 ? '' : 's' %>
          </p>

          <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked">
              <label class="form-check-label" for="switchCheckChecked">Display total after taxes</label>
            </div>
          </div>
        </div>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1" id="listingsGrid">
          <%- include("../includes/listingsGrid.ejs", { allListings }) %>
        </div>
      </div>
    </div>
  </body>
  <script src="js/showTax.js"></script>
  <script src="/js/wishlist.js"></script>
  <script src="/js/filterSidebar.js"></script>
