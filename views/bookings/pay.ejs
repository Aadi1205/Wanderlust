<% layout("layouts/boilerplate") %>

  <div class="row mt-3">
    <div class="col-12 col-md-6 offset-md-3 px-3">
      <h3 class="mb-4">Complete your payment</h3>

      <div class="reserve-summary-card mb-4">
        <img
          src="<%= booking.listing.image.url || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>"
          class="reserve-summary-img" alt="Listing image" />
        <div class="reserve-summary-body">
          <h5 class="mb-1">
            <%= booking.listing.title %>
          </h5>
          <p class="text-muted mb-1">
            <%= booking.checkIn.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
              &rarr;
              <%= booking.checkOut.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
          </p>
          <p class="mb-0">
            <%= booking.nights %> night<%= booking.nights> 1 ? "s" : "" %> &middot;
              <%= booking.guests %> guest<%= booking.guests> 1 ? "s" : "" %>
          </p>
        </div>
      </div>

      <div class="booking-widget" id="payWidget" data-booking-id="<%= booking._id %>">
        <div class="booking-price-breakdown mb-3">
          <div class="d-flex justify-content-between">
            <span>&#8377;<%= booking.pricePerNight.toLocaleString("en-IN") %> x <%= booking.nights %>
                night<%= booking.nights> 1 ? "s" : "" %></span>
            <span>&#8377;<%= booking.subtotal.toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between">
            <span>Taxes (18%)</span>
            <span>&#8377;<%= booking.taxes.toLocaleString("en-IN") %></span>
          </div>
          <hr class="my-2">
          <div class="d-flex justify-content-between fw-bold">
            <span>Total</span>
            <span>&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></span>
          </div>
        </div>

        <button type="button" id="payNowBtn" class="btn btn-dark add-btn w-100">Pay now</button>
        <p id="payStatus" class="text-muted mt-2 mb-0"></p>
      </div>
    </div>
  </div>

  <script src="/js/payment.js"></script>
