# MongoDB Atlas connection string
ATLAS_DB_URL=your_mongodb_atlas_url

# Session
SESSION_SECRET=your_session_secret

# Cloudinary (image + avatar uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Razorpay (test mode keys from the Razorpay dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay webhook secret (dashboard -> Settings -> Webhooks -> create a
# webhook pointing at /webhooks/razorpay, subscribe to payment.captured and
# payment.failed, then copy the secret you set there into this var)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# development | production
NODE_ENV=development
